# Keys stay in this local backend. Never put keys in extension code.
OPENAI_API_KEY=
EXA_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Optional: all of these use the same OPENAI_API_KEY.
OPENAI_DECISION_MODEL=gpt-6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
PORT=4318
# Sample searches SQLite first; with both keys, unmatched items automatically search Exa.
# Web matches are saved as demo catalog items with their original sources and stable prices.
# Without an AI key, description-based catalog search still works. Live also needs EXA_API_KEY.
NEEDLE_MODE=sample
DATABASE_PATH=.local/needle.sqlite
